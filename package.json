{
  "name": "users-management-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "dev:up": "docker compose -p management-web-dev -f compose.dev.yml up -d --build --wait",
    "dev:down": "docker compose -p management-web-dev -f compose.dev.yml down",
    "format": "prettier --write src tests *.ts *.mts *.json *.md docs/CI.md infra/ci/*.mjs .github",
    "format:check": "prettier --check src tests *.ts *.mts *.json *.md docs/CI.md infra/ci/*.mjs .github",
    "dev:logs": "docker compose -p management-web-dev -f compose.dev.yml logs -f --tail=80",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test --config playwright.ci.config.ts",
    "test:stack": "playwright test",
    "check": "npm run workflows:check && npm run format:check && npm run typecheck && npm run test:unit && npm run build",
    "workflows:check": "node infra/ci/validate-workflows.mjs"
  },
  "dependencies": {
    "jose": "6.2.16",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
