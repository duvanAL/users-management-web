{
  "name": "users-management-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "dev:up": "docker compose -p management-web-dev -f compose.dev.yml up -d --build --wait",
    "dev:down": "docker compose -p management-web-dev -f compose.dev.yml down",
    "format": "prettier --write src tests *.ts *.json *.md",
    "format:check": "prettier --check src tests *.ts *.json *.md",
    "dev:logs": "docker compose -p management-web-dev -f compose.dev.yml logs -f --tail=80"
  },
  "dependencies": {
    "jose": "6.2.15",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "7.0.2"
  }
}
