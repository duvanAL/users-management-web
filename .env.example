ACCOUNTS_URL=http://localhost:18081
FILES_URL=http://localhost:18083
SEARCH_URL=http://localhost:18084
NOTIFICATIONS_URL=http://localhost:18082
FILE_DOWNLOAD_ORIGIN=http://s3:9090
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
